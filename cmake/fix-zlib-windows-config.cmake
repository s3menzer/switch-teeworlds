if(NOT DEFINED ZLIB_INCLUDE_DIR)
  message(FATAL_ERROR "ZLIB_INCLUDE_DIR must point to the zlib include directory")
endif()

set(_zconf "${ZLIB_INCLUDE_DIR}/zconf.h")
if(NOT EXISTS "${_zconf}")
  message(FATAL_ERROR "zconf.h not found: ${_zconf}")
endif()

file(READ "${_zconf}" _zconf_contents)
set(_unix_config "#if 1           /* HAVE_UNISTD_H -- this line is updated by ./configure */")
set(_windows_config "#if !defined(_WIN32) /* HAVE_UNISTD_H -- this line is updated by ./configure */")

string(FIND "${_zconf_contents}" "${_unix_config}" _unix_config_index)
if(NOT _unix_config_index EQUAL -1)
  string(REPLACE "${_unix_config}" "${_windows_config}" _zconf_contents "${_zconf_contents}")
  file(WRITE "${_zconf}" "${_zconf_contents}")
  message(STATUS "Adjusted zlib zconf.h for Windows: disabled the POSIX unistd.h include")
else()
  string(FIND "${_zconf_contents}" "${_windows_config}" _windows_config_index)
  if(_windows_config_index EQUAL -1)
    message(FATAL_ERROR "Unexpected HAVE_UNISTD_H configuration in ${_zconf}; refusing to modify it")
  endif()
  message(STATUS "zlib zconf.h is already configured for Windows")
endif()
